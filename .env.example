# =============================================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ NEXT.JS
# =============================================================================
# Правила работы:
#
#   NEXT_PUBLIC_*  →  доступна И на сервере, И в браузере.
#                     Значение "вшивается" в JS-бандл на этапе `yarn build`.
#                     Меняете значение → нужен повторный build + деплой.
#                     Используйте только для несекретных данных, которые
#                     нужны в клиентских компонентах ("use client").
#
#   БЕЗ префикса  →  читается серверным кодом. Значение может попасть в HTML
#                     или props клиентского компонента, если передать его явно.
#                     На страницах force-static читается при сборке: после
#                     изменения нужны `yarn build` и перезапуск сервера.
#                     Для кода, выполняемого при запросе, достаточно перезапуска.
# =============================================================================


# -----------------------------------------------------------------------------
# ПУБЛИЧНЫЕ (NEXT_PUBLIC_) — вшиваются в бандл при сборке
# -----------------------------------------------------------------------------

# Базовый URL сайта. Используется в метатегах, canonical, OG-изображениях,
# sitemap и т.п.
NEXT_PUBLIC_SITE_URL=https://medtaxi-evp.ru

# На production Nginx должен проксировать /api/ в conditioners-server на
# 127.0.0.1:3235, сохраняя /api в URI (см. deploy/nginx-next.conf.example).
# Разверните новый backend раньше frontend: форма проверяет requestId и leadId.
# /api — относительный адрес на текущем домене, а не обработчик Next.js.
# Для reserve.medtaxi-evp.ru также настройте /api/ (nginx-reserve.conf.example)
# и добавьте его HTTPS origin в MEDTAXI_ADDITIONAL_ORIGINS только на backend.
# Основной MEDTAXI_URL backend и NEXT_PUBLIC_SITE_URL оставьте каноническими.
# В development без Nginx: http://localhost:3235/api и MEDTAXI_URL на backend,
# точно совпадающий с origin frontend (обычно http://localhost:3079).
# Значение вшивается при build; после изменения пересоберите frontend.
# ⚠️ Не храните здесь секреты — значение видно в исходниках страницы.
NEXT_PUBLIC_API_URL=/api


# -----------------------------------------------------------------------------
# СЕРВЕРНЫЕ (без префикса) — читаются серверным кодом
# -----------------------------------------------------------------------------

# Телефон донецких направлений. Читается серверным кодом.
# /donetsk и /donetsk/moskva используют dynamic = "force-static".
# /uslugi/perevozka-donetsk-krym также генерируется при сборке.
# Номер записывается в готовый HTML при сборке.
# После изменения .env выполните `yarn build` и перезапустите сервер.
DONETSK_PHONE_HREF=+79490676701
