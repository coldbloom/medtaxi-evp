# Adapt INSIDE the existing medtaxi-evp.ru HTTPS server {} block.
# Keep listen/TLS, HTTP->HTTPS redirects, security headers and backend locations.
# Replace the old frontend static locations/error_page pointing at out/.
# next start must listen on 127.0.0.1:3000 (see medtaxi-next.service.example).

location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_intercept_errors off;
}

# Only content-hashed photo URLs receive an immutable cache policy.
# An existing /api/ location keeps routing requests to the separate backend.
location ~ "^/donetsk/images/[^/]+-[0-9a-f]{12}\.(avif|webp)$" {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "public, max-age=31536000, immutable";
    # If the server has add_header security directives, repeat/include them here:
    # location-level add_header changes normal Nginx header inheritance.
}
