# Include/adapt INSIDE the existing medtaxi-evp.ru server {} block.
# Replace the placeholder root with the actual frontend-only deployment directory.
# Keep the domain's existing listen, TLS certificates, HTTP->HTTPS redirect,
# security headers and backend proxy locations. Do not duplicate locations.
# The http {} configuration must already include the standard mime.types file.
# If server-level security headers use add_header, repeat/include those headers
# in the locations below: local add_header directives override normal inheritance.

root /ABSOLUTE/PATH/TO/MEDTAXI_STATIC;
index index.html;

location / {
    # Preserve the slashless canonical URLs; the home page stays at /.
    # A more specific existing /api/ proxy location continues to take precedence.
    if ($uri ~ "^(.+)/$") {
        return 308 $1$is_args$args;
    }

    # .html must win over a same-named directory such as /donetsk/.
    try_files $uri.html $uri $uri/ =404;
    add_header Cache-Control "no-cache" always;
}

# These build assets have versioned filenames.
location ^~ /_next/static/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
}

# Only content-hashed AVIF/WebP files receive an immutable image cache policy.
location ~ "^/donetsk/images/[^/]+-[0-9a-f]{12}\.(avif|webp)$" {
    types {
        image/avif avif;
        image/webp webp;
    }
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
}

# Return the exported error page with HTTP 404, never an SPA 200 fallback.
error_page 404 /404.html;
location = /404.html {
    internal;
    add_header Cache-Control "no-cache" always;
}

# Merge with existing compression settings if they are already configured.
gzip on;
gzip_vary on;
gzip_types text/plain text/css application/javascript application/json
           application/xml text/xml image/svg+xml;
